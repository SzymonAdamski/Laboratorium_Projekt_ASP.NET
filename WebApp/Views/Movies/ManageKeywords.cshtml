@model WebApp.Models.Movie

<div class="container mt-4">
    <h1>Zarządzanie Słowami Kluczowymi - @Model.Title</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Dodaj Nowe Słowo Kluczowe</h5>
                    <form asp-action="AddKeyword" method="post" class="mt-3">
                        <input type="hidden" name="MovieId" value="@Model.MovieId" />
                        <div class="input-group">
                            <input type="text" name="Keyword" class="form-control" placeholder="Wpisz słowo kluczowe..." required />
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Dodaj
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Aktualne Słowa Kluczowe</h5>
                    @if (Model.MovieKeywords != null && Model.MovieKeywords.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var movieKeyword in Model.MovieKeywords)
                            {
                                <div class="keyword-tag">
                                    <span class="badge bg-primary d-inline-flex align-items-center">
                                        @movieKeyword.Keyword.KeywordName
                                        <form asp-action="RemoveKeyword" method="post" class="d-inline ms-2">
                                            <input type="hidden" name="MovieId" value="@Model.MovieId" />
                                            <input type="hidden" name="KeywordId" value="@movieKeyword.KeywordId" />
                                            <button type="submit" class="btn btn-link text-white p-0 border-0" 
                                                    onclick="return confirm('Czy na pewno chcesz usunąć to słowo kluczowe?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mt-3">Brak słów kluczowych</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @{
            var companyId = Model.MovieProductionCompanies?.FirstOrDefault()?.CompanyId;
            if (companyId.HasValue)
            {
                <a asp-controller="ProductionCompanies" asp-action="Movies" 
                   asp-route-id="@companyId" 
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Powrót do listy
                </a>
            }
            else
            {
                <a asp-controller="Movies" asp-action="Index" 
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Powrót do listy filmów
                </a>
            }
        }
    </div>
</div>

<style>
    .keyword-tag {
        display: inline-block;
    }
    
    .keyword-tag .badge {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
    
    .keyword-tag button:hover {
        opacity: 0.8;
    }
</style>
